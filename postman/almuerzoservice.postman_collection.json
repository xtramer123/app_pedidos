{
  "info": {
    "name": "AlmuerzoService API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /auth/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Prueba\",\n  \"email\": \"juan@test.com\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('Has access_token', () => pm.expect(json.access_token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', json.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /auth/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@test.com\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('Has access_token', () => pm.expect(json.access_token).to.be.a('string'));",
                  "pm.collectionVariables.set('token', json.access_token);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Almuerzos",
      "item": [
        {
          "name": "GET /almuerzos",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/almuerzos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test('Is array', () => pm.expect(list).to.be.an('array'));",
                  "if (list.length > 0) {",
                  "  pm.test('Has total field', () => pm.expect(list[0]).to.have.property('total'));",
                  "  pm.collectionVariables.set('almuerzo_id', list[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /almuerzos",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/almuerzos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Carlos Prueba\",\n  \"plato\": \"Arroz con pollo\",\n  \"cantidad\": 2,\n  \"precio\": 15.50\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test('entregado is false', () => pm.expect(json.entregado).to.be.false);",
                  "pm.test('fecha_pedido present', () => pm.expect(json.fecha_pedido).to.be.a('string'));",
                  "pm.test('total correct', () => pm.expect(parseFloat(json.total)).to.equal(31.00));",
                  "pm.collectionVariables.set('almuerzo_id', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /almuerzos/:id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/almuerzos/{{almuerzo_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /almuerzos/:id",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/almuerzos/{{almuerzo_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"entregado\": true\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('entregado is true', () => pm.expect(pm.response.json().entregado).to.be.true);"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /almuerzos/:id",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/almuerzos/{{almuerzo_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /almuerzos — sin token (prueba 401)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/almuerzos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 401 sin token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
